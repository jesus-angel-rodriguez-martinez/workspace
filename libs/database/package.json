{
  "name": "@libs/database",
  "version": "1.0.0",
  "description": "Reusable database toolkit that composes the client and handles migration running and scaffolding from a validated configuration.",
  "keywords": [
    "@libs",
    "database"
  ],
  "license": "MIT",
  "author": "Jesús Ángel Rodríguez Martínez",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "database-migrate": "dist/infrastructures/bin/migrate.js",
    "database-scaffold": "dist/infrastructures/bin/scaffold.js"
  },
  "scripts": {
    "build": "npm run start:clean && npm run start:build",
    "start:build": "tsc && tsc-alias",
    "start:clean": "rimraf dist",
    "start:integration-test": "npm run start:test -- --testMatch '**/*.integration.test.ts'",
    "start:integration-test:coverage": "npm run start:test -- --coverage --testMatch '**/*.integration.test.ts'",
    "start:test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "start:test:coverage": "npm run start:test -- --coverage",
    "start:unit-test": "npm run start:test -- --testMatch '**/*.unit.test.ts'",
    "start:unit-test:coverage": "npm run start:test -- --coverage --testMatch '**/*.unit.test.ts'",
    "test": "npm run start:test"
  },
  "dependencies": {
    "@libs/configuration": "workspace:*",
    "@libs/kernel": "workspace:*",
    "@libs/logger": "workspace:*",
    "dotenv": "~17.3.1",
    "kysely": "~0.29.5",
    "pg": "~8.23.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "@types/pg": "~8.21.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.4",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
