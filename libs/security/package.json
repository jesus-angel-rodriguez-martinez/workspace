{
  "name": "@libs/security",
  "version": "1.0.0",
  "description": "Provides lightweight and reusable security utilities for handling credential processing, identity validation, and authentication token management.",
  "keywords": [
    "@libs",
    "security"
  ],
  "license": "MIT",
  "author": "Jesús Ángel Rodríguez Martínez",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run start:clean && npm run start:build",
    "start:build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start:clean": "rimraf dist",
    "start:integration-test": "npm run start:test -- --testMatch '**/*.integration.test.ts'",
    "start:integration-test:coverage": "npm run start:test -- --coverage --testMatch '**/*.integration.test.ts'",
    "start:test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests",
    "start:test:coverage": "npm run start:test -- --coverage",
    "start:unit-test": "npm run start:test -- --testMatch '**/*.unit.test.ts'",
    "start:unit-test:coverage": "npm run start:test -- --coverage --testMatch '**/*.unit.test.ts'",
    "test": "npm run start:test"
  },
  "dependencies": {
    "@libs/kernel": "workspace:*",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.1",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
